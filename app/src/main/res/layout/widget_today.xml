<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <!--
      Keep the host-inflated hierarchy deliberately tiny. The complete,
      responsive dashboard is rendered into this bitmap by TodayWidget.
    -->
    <ImageView
        android:id="@+id/widget_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Reconcile spending dashboard"
        android:scaleType="fitXY" />
</FrameLayout>
